types ValyriaDropDisplayTypes {
    
    
    type widget_drop_value_breakdown_tooltip = widget {
        name = "widget_drop_value_breakdown_tooltip"
        raw_text = "NOT_YET_IMPLEMENTED"
        
    }
    
    type drop_container_resource_balance = container {
        text_single = {
            name = "drop_balance_pos"
            visible = "[GetScriptedGui('zz_valyria_magic_management').IsShown(GetPlayer.MakeScope)]"
            text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_drops_power_passive_gain')|1=]"
            max_width = 110
            default_format = "#low"
        }
        
        text_single = {
            name = "balance_neg"
            visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('zz_valyria_drops_power_passive_gain'), '(CFixedPoint)0')]"
            text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_drops_power_passive_gain')|1=]"
            max_width = 110
            default_format = "#N"
        }
    }
    
    type tooltip_widget_sanctum_list_drops_of_power = widget {
        name = "tooltip_widget_sanctum_list_drops_of_power"
        alwaystransparent = no
        size = { 600 800 }
        using = DefaultTooltipBackground
        
        
        widget = {
            name = "tooltip_container"
            layoutpolicy_vertical = expanding
            layoutpolicy_horizontal = expanding
            size = { 600 800 }
            filter_mouse = all
            background = {}
            vbox = {
                layoutpolicy_vertical = expanding
                layoutpolicy_horizontal = expanding
                hbox = {
                    text_single = {
                        raw_text = "Maegi Drops Gain"
                        fontsize_min = 14
                        using = Font_Size_Medium
                        
                        block "title_text" {
                            margin = { 0 4 }
                        }
                    }
                }
                spacer = { size = { 0 20 }}
                scrollbox = {
                    name = "mages_scrollarea"
                    layoutpolicy_vertical = expanding
                    layoutpolicy_horizontal = expanding
                    
                    blockoverride "scrollbox_margins"
					{
					    using = Scrollbox_Margins
						margin_right = 5
                        margin_left = 5
						margin_top = 5
					}
                    blockoverride "scrollbox_content"
                    {   
                        
                        fixedgridbox = {
                            addcolumn = 600
                            addrow = 100
                            
                            datamodel = "[GetPlayer.MakeScope.GetList('mage_list')]"
                            
                            item = {
                                widget = {
                                    visible = "[GetScriptedGui('zz_valyria_magic_management').IsShown(GetPlayer.MakeScope)]"
                                    background = {
                                        using = Background_Area_Solid
                                    }
                                    size = { 600 90 }
                                    datacontext = "[Scope.GetCharacter]"
                                    hbox = {
                                        layoutpolicy_vertical = expanding
                                        layoutpolicy_horizontal = expanding
                                        portrait_head_small = {
                                            scale = 1
                                            tooltip_visible = no
                                        }
                                        spacer = { size = {10 0} }
                                        text_single = {
                                            text = "[Character.GetShortUINameNotMeNoTooltip]"
                                            min_width = 175
                                            max_width = 175
                                            align = left
                                            tooltipwidget = {
                                                cooltip_type = {}
                                            }
                                        }
                                        spacer = { size = {10 0} }
                                        zz_valyria_drops_of_power_infobox = {}
                                        expand = {}
                                    }
                                    
                                }
                            }
                        }
                    }
                }
                expand = {}
            }
            
            
        }
    }
    
    type zz_valyria_sanctum_drops_of_power_widget = widget {
        name = "condensed_drops_of_power"
        datacontext = "[GetPlayer.MakeScope]"
        button = {
            size = { 100 45 }
            # onclick = "[GetScriptedGui('zz_valyria_magic_management').Execute( GuiScope.SetRoot(GetPlayer.MakeScope) ).End]"
            
            using = tooltip_ne
            tooltipwidget = {
                tooltip_widget_sanctum_list_drops_of_power = {
                    datacontext = "[GetPlayer.MakeScope]"
                }
            }
        }
        
        background = {
            texture = "gfx/interface/skinned/resource_panel_piece.dds"
        }
        size = { 112 70 }
        
        hbox = {
            layoutpolicy_horizontal = expanding
            
            hbox = {
                layoutpolicy_horizontal = expanding
                layoutpolicy_vertical = expanding
                # spacing = 6
                vbox = {
                    layoutpolicy_horizontal = expanding
                    layoutpolicy_vertical = expanding
                    margin_bottom = 30
                    margin_left = 10 
                    icon = {
                        name = "drops_icon"
                        size = { 30 30 }
                        texture = "gfx/interface/icons/zz_drops_of_power.dds"
                    }
                }
                flowcontainer = {
                    layoutpolicy_horizontal = expanding
                    margin_bottom = 38
                    spacing = -8
                    direction = vertical
                    
                    text_single = {
                        
                        name = "drops_value"
                        text = "[GetPlayer.MakeScope.ScriptValue('zz_valyria_drops_of_power_stat')]"
                        
                        max_width = 50
                        default_format = "#high"
                        using = Font_Size_Medium
                    }
                    
                    drop_container_resource_balance = {}
                }
            }
            
            # expand = {}
            
            divider_light = {
                layoutpolicy_vertical = expanding
                alpha = 0.8
            }
        }
        # expand = {}
    }
    type zz_valyria_drops_of_power_character = widget {
		alwaystransparent = no
		using = GeneralTooltipSetup
		widget = {
			name = "background"
			alwaystransparent = no
			size = { 100% 100% }
			using = DefaultTooltipBackground
		}
        vbox = {
			set_parent_size_to_minimum = yes
			margin = { 10 15 }
			
            zz_valyria_drops_of_power_infobox = {}
        }
        widget = {
			name = "locked_frame"
			size = { 100% 100% }
			using = TooltipLockedFrame
			alwaystransparent = yes
		}
    } 
    type zz_valyria_drops_of_power_infobox hbox {
        layoutpolicy_horizontal = expanding
        spacing = 10
        
        vbox = {
            layoutpolicy_vertical = expanding
            spacing = 10
            text_single = {
                raw_text = "Drops of Power:"
                min_width = 100
                max_width = 100
                align = left
                default_format = "#high"
                using = Font_Size_Small
            }
            text_single = {
                raw_text = "Passive Gain:"
                min_width = 100
                max_width = 100
                align = left
                default_format = "#high"
                using = Font_Size_Small
                tooltipwidget = {
                    widget_drop_value_breakdown_tooltip = {}
                }
            }
            text_single = {
                raw_text = "Multiplier:"
                min_width = 100
                max_width = 100
                align = left
                default_format = "#high"
                using = Font_Size_Small
                tooltipwidget = {
                    widget_drop_value_breakdown_tooltip = {}
                }
            }
            expand ={}
        }
        expand ={}
        vbox = {
            layoutpolicy_vertical = expanding
            spacing = 10
            text_single = {
                text = "zz_valyria_mana"
                min_width = 200
                max_width = 200
                align = left
                default_format = "#high"
                using = Font_Size_Small
            }
            text_single = {
                text = "zz_mana_gain_passive"
                min_width = 200
                max_width = 200
                align = left
                default_format = "#high"
                using = Font_Size_Small
                tooltip_visible = "[ValueBreakdown.HasTooltip]"
                tooltipwidget = {
                    widget_value_breakdown_tooltip = {
                        datacontext = "[GuiScope.SetRoot( Character.MakeScope ).GetScriptValueBreakdown( 'zz_valyria_drops_power_passive_gain' )]"
                        blockoverride "header_text"
                        {
                            text = "zz_valyria_drops_power_passive_gain_name"
                        }
                    }
                }
            }
            text_single = {
                
                text = "zz_valyria_mana_gain_mult"
                min_width = 200
                max_width = 200
                align = left
                default_format = "#high"
                using = Font_Size_Small
                tooltip_visible = "[ValueBreakdown.HasTooltip]"
                tooltipwidget = {
                    widget_value_breakdown_tooltip = {
                        datacontext = "[GuiScope.SetRoot( Character.MakeScope ).GetScriptValueBreakdown( 'zz_valyria_mana_gain_mult' )]"
                        blockoverride "header_text"
                        {
                            text = "zz_valyria_mana_gain_mult_name"
                        }
                        
                    }
                }
            }
            expand ={}
        }
    }
}


