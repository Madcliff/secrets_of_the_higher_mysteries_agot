widget = {
	allow_outside = yes
	name = "event_window_maa_selection_03"
	minimumsize = { 350 250 }
	
	vbox = {
		#text_single = {block "header" { text = "This is a Header" } }
		container = {
			allow_outside = yes
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			datacontext = "[GetPlayer.MakeScope]"
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 350 250 }
				blockoverride "scrollbox_content" {
					vbox = {
						datamodel = "[Scope.GetList('possible_regiments_03')]"
						
						item = {
							button_standard = {
								size = { 300 45 }
								datacontext = "[Scope.Regiment]"
								
								down = "[GetScriptedGui( 'zz_valyria_regiment_selecting_03' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_regiment_03', Regiment.MakeScope ).End )]"
								onclick = "[GetScriptedGui( 'zz_valyria_regiment_selecting_03' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_regiment_03', Regiment.MakeScope ).End )]"
								
								widget = {
									size = { 260 45 }
									parentanchor = right
									text_single = {
										text = "[Regiment.GetName]"
										parentanchor = center
										#default_format = "#high"
										using = Font_Size_Medium
									}
									text_single = {
										text = "[Regiment.BuildCurrentRegimentCountString|V]"
										default_format = "#high"
									}
								}
							}
						}
					}
					spacer = { size = { 0 20 } }
				}
			}
		}
	}
}