widget = {
	allow_outside = yes
	name = "event_window_secret_known_selection"
	minimumsize = { 350 250 }

	vbox = {
		#text_single = {block "header" { text = "This is a Header" } }
		container = {
			allow_outside = yes
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			datacontext = "[GetPlayer.MakeScope]"
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 350 250 }
				blockoverride "scrollbox_content" {
					vbox = {
						datamodel = "[Scope.GetList('possible_secret')]"

						item = {
							button_standard = {
								size = { 300 45 }
								datacontext = "[Scope.Secret]"

								down = "[GetScriptedGui( 'zz_valyria_secret_knonw_selecting' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_secret', Secret.MakeScope ).End )]"
								onclick = "[GetScriptedGui( 'zz_valyria_secret_known_selecting' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_secret', Secret.MakeScope ).End )]"

								widget = {
									size = { 90 45 }
									parentanchor = left
								}
								widget = {
									size = { 260 45 }
									parentanchor = right
									text_single = {
										text = "[Secret.GetName]"
										parentanchor = center
										#default_format = "#high"
										using = Font_Size_Medium
									}
								}
							}
						}
					}
					spacer = { size = { 0 20 } }
				}
			}
		}
	}
}