widget = {
	allow_outside = yes
	name = "event_window_trait_selection"
	size = { 350 250 } # Size of the insert inside the event window; needs to fit under the text box since a margin will only push the content and not the widget

	vbox = {
		#text_single = {block "header" { text = "This is a Header" } }
		container = {
			allow_outside = yes
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			datacontext = "[GetPlayer.MakeScope]"
			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				minimumsize = { 350 250 }
				blockoverride "scrollbox_content" {
					vbox = {
						datamodel = "[Scope.GetList('possible_traits')]"
						item = {
							button_standard = {
								size = { 300 45 }
								datacontext = "[Scope.Trait]"
								down = "[GetScriptedGui( 'zz_valyria_trait_selecting' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_trait', Trait.MakeScope ).End )]"
								onclick = "[GetScriptedGui( 'zz_valyria_trait_selecting' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'selected_trait', Trait.MakeScope ).End )]"
								tooltip = "[Trait.GetNameNoTooltip( GetNullCharacter )]"

								text_single = {
									text = "[Trait.GetNameNoTooltip( GetNullCharacter )]"
									max_width = 280
									parentanchor = center
									align = center|nobaseline
									#default_format = "#high"
									using = Font_Size_Medium
								}
							}
						}
					}
					spacer = { size = { 0 20 } }
				}
			}
		}
	}
}